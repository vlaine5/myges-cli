NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_SECRET=change-me-with-a-long-random-secret
DATABASE_URL=file:./data/app.db
APP_DATA_DIR=./data
LOG_LEVEL=info

ACADEMIC_PROVIDER=myges

MYGES_USERNAME=
MYGES_PASSWORD=

MYEFREI_USERNAME=
MYEFREI_PASSWORD=
MYEFREI_SESSION_COOKIE=
MYEFREI_AGENDA_ENDPOINT=
ENSUP_USERNAME=
ENSUP_PASSWORD=
ENSUP_SESSION_COOKIE=
ENSUP_AGENDA_ENDPOINT=

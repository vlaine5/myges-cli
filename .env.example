# ============================================================
# Infrastructure — toujours lu au demarrage, requis
# ============================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Adresse publique reelle utilisee pour acceder a l'app (sert de valeur
# par defaut a l'URL de redirection OAuth Google si rien n'est configure).
APP_BASE_URL=http://localhost:3000
# Chiffre tous les secrets stockes en base (mots de passe, cookies de
# session, credentials OAuth). Change-le et garde-le stable: le perdre
# rend tous les secrets deja stockes en base illisibles.
APP_SECRET=change-me-with-a-long-random-secret
DATABASE_URL=file:./data/app.db
APP_DATA_DIR=./data
LOG_LEVEL=info
# Perimetre des autorisations demandees a Google a la connexion OAuth.
# Lu a chaque authentification, jamais stocke en base.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar

# ============================================================
# Parametres de sync par defaut — ne servent qu'a initialiser la base
# au tout premier demarrage (table AppSettings). Une fois l'app lancee,
# ils sont ensuite modifiables uniquement depuis l'interface (/settings)
# et ces variables ne sont plus relues.
# ============================================================
ACADEMIC_PROVIDER=myges
SYNC_ENABLED=false
SYNC_LOOKBACK_DAYS=7
SYNC_FUTURE_DAYS=30
SYNC_FREQUENCY_MINUTES=30
SYNC_RUN_ON_STARTUP=false
GOOGLE_SYNC_ENABLED=false
SAVE_LAST_ICS=true
STORE_RAW_PAYLOAD=false
TIMEZONE=Europe/Paris

# ============================================================
# Identifiants providers — optionnels. Ne servent qu'a pre-remplir la
# base au tout premier demarrage, SEULEMENT si aucun identifiant n'est
# deja enregistre pour ce provider. Une fois configures (via l'env ou
# via /provider), c'est l'interface qui fait foi: ces variables ne sont
# plus jamais relues, les modifier ici n'aura plus aucun effet.
# Inutile de les remplir si tu comptes tout configurer depuis /provider.
# ============================================================
MYGES_USERNAME=
MYGES_PASSWORD=

MYEFREI_USERNAME=
MYEFREI_PASSWORD=
MYEFREI_SESSION_COOKIE=
MYEFREI_AGENDA_ENDPOINT=

ENSUP_USERNAME=
ENSUP_PASSWORD=
ENSUP_SESSION_COOKIE=
ENSUP_AGENDA_ENDPOINT=
ENSUP_ICS_URL=

# ============================================================
# Google OAuth — optionnel. Comme ci-dessus, ne sert qu'a pre-remplir
# la base si elle est vide. Une fois des credentials enregistres (via
# l'env ou via /google), c'est l'interface qui fait foi a chaque
# connexion: inutile de les dupliquer ici si tu configures tout via
# l'ecran "Configuration requise" de /google.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/google/oauth/callback
GOOGLE_DEFAULT_CALENDAR_ID=

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                   Int      @id @default(1)
  provider             String   @default("myges")
  timezone             String   @default("Europe/Paris")
  syncEnabled          Boolean  @default(false)
  syncLookbackDays     Int      @default(7)
  syncFutureDays       Int      @default(30)
  syncFrequencyMinutes Int      @default(30)
  syncDayOfWeek        Int?
  syncHour             Int      @default(6)
  runSyncOnStartup     Boolean  @default(false)
  googleSyncEnabled    Boolean  @default(false)
  saveLastIcs          Boolean  @default(true)
  storeRawPayload      Boolean  @default(false)
  logLevel             String   @default("info")
  updatedAt            DateTime @updatedAt
}

model AgendaConfig {
  id               String    @id @default(cuid())
  name             String
  provider         String
  fetchMode        String    @default("api")
  icsUrlEncrypted  String?
  enabled          Boolean   @default(true)
  syncEnabled      Boolean   @default(false)
  syncDayOfWeek    Int?
  syncHour         Int       @default(6)
  lookbackDays     Int       @default(7)
  lookaheadDays    Int       @default(30)
  googleCalendarId String?
  lastSyncAt       DateTime?
  lastSyncStatus   String?
  lastSyncError    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([syncEnabled])
}

model AcademicProviderCredential {
  provider             String   @id
  authMode             String?
  username             String?
  passwordEncrypted    String?
  accessToken          String?
  tokenType            String?
  accessTokenExpiresAt DateTime?
  sessionCookieEncrypted String?
  configJson           String?
  lastLoginAt          DateTime?
  lastLoginError       String?
  updatedAt            DateTime @updatedAt
}

model GoogleConnection {
  id                    Int      @id @default(1)
  clientIdEncrypted     String?
  clientSecretEncrypted String?
  oauthRedirectUrl      String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenType             String?
  scope                 String?
  expiryDate            DateTime?
  connectedEmail        String?
  calendarId            String?
  calendarSummary       String?
  updatedAt             DateTime @updatedAt
}

model GoogleProviderCalendar {
  provider        String   @id
  calendarId      String?
  calendarSummary String?
  updatedAt       DateTime @updatedAt
}

model OAuthState {
  state     String   @id
  provider  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model EventSnapshot {
  id                String       @id
  provider          String
  // agendaId links to AgendaConfig.id — set when synced via an agenda, null for manual imports
  agendaId          String?
  sourceId          String
  reservationId     Int?
  title             String
  subject           String?
  startAt           DateTime
  endAt             DateTime
  teacher           String?
  room              String?
  campus            String?
  roomsJson         String?
  promotion         String?
  groupName         String?
  classesJson       String?
  modality          String?
  reservationType   String?
  studentCount      Int?
  disciplineName    String?
  disciplineTeacher String?
  disciplineId      Int?
  sourceHash        String
  rawPayload        String?
  lastSeenAt        DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Every snapshot always belongs to exactly one GlobalEvent (1:1 "solo" at ingestion,
  // or merged into a shared GlobalEvent once a human/strong-evidence link is made).
  globalEventId     String
  globalEvent       GlobalEvent  @relation(fields: [globalEventId], references: [id])
  matches           EventMatch[]

  @@index([startAt])
  @@index([reservationId])
  @@index([provider, startAt])
  @@index([agendaId])
  @@index([globalEventId])
}

// The canonical "real class" tier: one GlobalEvent may be backed by several
// per-provider EventSnapshot rows (MyGES + an ICS import of the same class, etc).
// Google sync always targets a GlobalEvent, never a raw snapshot.
model GlobalEvent {
  id                String    @id @default(cuid())
  title             String
  subject           String?
  startAt           DateTime
  endAt             DateTime
  teacher           String?
  room              String?
  campus            String?
  promotion         String?
  groupName         String?
  modality          String?
  // The snapshot currently used as the "template" for this GlobalEvent's display
  // fields and target Google calendar. Sticky: only re-picked on creation, on the
  // current primary disappearing, or an explicit user action — never silently.
  primarySnapshotId String?   @unique
  // Soft-retired (merged away) GlobalEvents are kept for audit history, never deleted.
  retiredAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  snapshots EventSnapshot[]
  matches   EventMatch[]
  mapping   EventMapping?

  @@index([startAt])
  @@index([retiredAt])
}

// Audit trail of every link/unlink decision, machine or human. Rows are append-only:
// confirming/rejecting/unlinking always writes a NEW row, existing rows are never
// updated or deleted.
model EventMatch {
  id             String    @id @default(cuid())
  globalEventId  String
  snapshotId     String
  status         String    // AUTO_LINKED | SUGGESTED | AMBIGUOUS | CONFIRMED | REJECTED | UNLINKED
  matchBasis     String    // VERIFIED_IDENTIFIER | APPROVED_PRIOR_MATCH | FUZZY_RESEMBLANCE
  confidence     Float?
  reasonJson     String?
  decidedBy      String?
  decidedAt      DateTime  @default(now())

  globalEvent GlobalEvent   @relation(fields: [globalEventId], references: [id], onDelete: Cascade)
  snapshot    EventSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([globalEventId])
  @@index([snapshotId])
  @@index([status])
}

model EventMapping {
  id               String      @id @default(cuid())
  provider         String
  globalEventId    String      @unique
  googleEventId    String?
  lastSyncedHash   String?
  lastKnownStartAt DateTime
  lastKnownEndAt   DateTime
  lastAction       String?
  lastSyncedAt     DateTime?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  globalEvent      GlobalEvent @relation(fields: [globalEventId], references: [id], onDelete: Cascade)

  @@index([lastKnownStartAt])
  @@index([provider, lastKnownStartAt])
}

model SyncJob {
  id             String   @id @default(cuid())
  provider       String
  trigger        String
  dryRun         Boolean  @default(false)
  status         String
  rangeStart     DateTime
  rangeEnd       DateTime
  eventsFetched  Int      @default(0)
  eventsDeduped  Int      @default(0)
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  deletedCount   Int      @default(0)
  unchangedCount Int      @default(0)
  exportedCount  Int      @default(0)
  errorMessage   String?
  summary        String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?

  changes SyncJobEventChange[]

  @@index([startedAt])
  @@index([provider, startedAt])
}

// Per-change audit log for a sync job, written inline as actions are applied.
// Enables listing + rolling back individual Google sync actions after the fact.
model SyncJobEventChange {
  id            String   @id @default(cuid())
  syncJobId     String
  globalEventId String?
  snapshotId    String?
  action        String   // CREATED | UPDATED | DELETED | ROLLED_BACK
  googleEventId String?
  beforeJson    String?
  afterJson     String?
  createdAt     DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([globalEventId])
}

model IcsImport {
  id                  String    @id @default(cuid())
  name                String
  sourceType          String    // 'manual_upload' | 'manual_url'
  provider            String    // final provider used for events
  detectedProvider    String?   // provider detected from ICS metadata
  detectionConfidence String?   // 'high' | 'medium' | 'low' | 'none'
  icsUrl              String?   // for manual_url source type
  originalFilename    String?   // for manual_upload source type
  status              String    @default("SUCCESS") // SUCCESS | FAILED
  fetchedCount        Int       @default(0)
  createdCount        Int       @default(0)
  updatedCount        Int       @default(0)
  duplicateCount      Int       @default(0)
  skippedCount        Int       @default(0)
  errorMessage        String?
  removedFutureCount  Int       @default(0)
  keptPastCount       Int       @default(0)
  importedAt          DateTime  @default(now())
  lastReimportAt      DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([importedAt])
  @@index([provider])
}

// Tracks which EventSnapshot rows were created/seen by each IcsImport.
// Enables: listing events per import, sync semantics on reimport, safe delete.
model IcsImportEvent {
  importId String
  eventId  String

  @@id([importId, eventId])
  @@index([importId])
  @@index([eventId])
}

model IcsExport {
  id         String   @id @default(cuid())
  provider   String
  path       String
  eventCount Int
  rangeStart DateTime
  rangeEnd   DateTime
  generatedAt DateTime @default(now())

  @@index([generatedAt])
  @@index([provider, generatedAt])
}

// Persistent enrichment rules that are re-applied during ICS preview and import.
// A rule matches events by criteria (provider, class substring, subject substring, room, keywords)
// and injects field values that override the parsed result.
model EventEnrichmentRule {
  id   String @id @default(cuid())
  name String

  // Match criteria (all conditions are ANDed; omit a field to match any value)
  matchProvider    String?  // exact provider id: 'myges' | 'myefrei' | 'ensup' | 'generic'
  matchClassLike   String?  // case-insensitive substring match on any class name
  matchSubjectLike String?  // case-insensitive substring match on subject / title
  matchRoomLike    String?  // case-insensitive substring match on room / location
  matchKeywords    String?  // JSON array of strings — all must appear in title+subject+description

  // Values to inject when the rule matches (null = do not override)
  injectProvider     String?
  injectClass        String?
  injectSubject      String?
  injectTeacher      String?
  injectRoom         String?
  injectCampus       String?
  injectStudentCount Int?
  injectModality     String?

  // Higher priority rules win when multiple rules match.
  priority  Int     @default(0)
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([matchProvider])
}
